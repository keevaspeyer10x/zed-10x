#!/usr/bin/env bash

set -euo pipefail
source script/lib/blob-store.sh

build_flag="--release"
target_dir="release"
open_result=false
local_install=false
can_code_sign=false
zed_10x_release=false
certificate_base64=""
certificate_password=""
notarization_key=""
notarization_key_id=""
notarization_issuer_id=""
notarization_timeout="60m"
signing_keychain=""
certificate_file=""
notarization_key_file=""

# This must match the team in the provisioning profile.
IDENTITY="Zed Industries, Inc."
APPLE_NOTARIZATION_TEAM="MQ55VZLNZQ"

# Function for displaying help info
help_info() {
  echo "
Usage: ${0##*/} [options] [architecture=host]
Build the application bundle for macOS.

Options:
  -d    Compile in debug mode
  -o    Open dir with the resulting DMG or launch the app itself in local mode.
  -i    Install the resulting DMG into /Applications.
  --zed-10x-prepare-release
        Build fork-owned release inputs without signing credentials.
  -h    Display this help and exit.
  "
}

while [[ $# -gt 0 ]]; do
    case "$1" in
        -o) open_result=true;;
        -d)
            export CARGO_INCREMENTAL=true
            export CARGO_BUNDLE_SKIP_BUILD=true
            build_flag="";
            target_dir="debug"
            ;;
        -i) local_install=true;;
        --zed-10x-prepare-release) zed_10x_release=true;;
        -h|--help)
           help_info
           exit 0
           ;;
        --)
            shift
            break
            ;;
        -*)
            echo "Unknown option: $1" >&2
            exit 2
            ;;
        *) break;;
    esac
    shift
done


# Get release channel
pushd crates/zed
channel=$(<RELEASE_CHANNEL)
export ZED_RELEASE_CHANNEL="${channel}"
popd

if [[ "$zed_10x_release" == true ]]; then
    if [[ "$channel" != "dev" || "$target_dir" != "release" ]]; then
        echo "--zed-10x-prepare-release requires the dev channel and a release build" >&2
        exit 2
    fi
    if [[ "$local_install" == true ]]; then
        echo "--zed-10x-prepare-release cannot install over a local application" >&2
        exit 2
    fi
elif [[ -n "${MACOS_CERTIFICATE:-}" && -n "${MACOS_CERTIFICATE_PASSWORD:-}" && -n "${APPLE_NOTARIZATION_KEY:-}" && -n "${APPLE_NOTARIZATION_KEY_ID:-}" && -n "${APPLE_NOTARIZATION_ISSUER_ID:-}" ]]; then
    can_code_sign=true
    certificate_base64="$MACOS_CERTIFICATE"
    certificate_password="$MACOS_CERTIFICATE_PASSWORD"
    notarization_key="$APPLE_NOTARIZATION_KEY"
    notarization_key_id="$APPLE_NOTARIZATION_KEY_ID"
    notarization_issuer_id="$APPLE_NOTARIZATION_ISSUER_ID"
fi

export ZED_BUNDLE=true

cargo_bundle_revision="2be2669972dff3ddd4daf89a2cb29d2d06cad7c7"
cargo_bundle_version=$(cargo -q bundle --help 2>&1 | head -n 1 || echo "")
if [[ "$cargo_bundle_version" != "cargo-bundle v0.6.1-zed" || "$zed_10x_release" == true ]]; then
    cargo install \
        --force \
        --locked \
        --git https://github.com/zed-industries/cargo-bundle.git \
        --rev "$cargo_bundle_revision" \
        cargo-bundle
fi

# Deal with versions of macOS that don't include libstdc++ headers
export CXXFLAGS="-stdlib=libc++"

version_info=$(rustc --version --verbose)
host_line=$(echo "$version_info" | grep host)
target_triple=${host_line#*: }
if [[ $# -gt 0 && -n "$1" ]]; then
    target_triple="$1"
fi
arch_suffix=""

if [[ "$target_triple" = "x86_64-apple-darwin" ]]; then
    arch_suffix="x86_64"
elif [[ "$target_triple" = "aarch64-apple-darwin" ]]; then
    arch_suffix="aarch64"
else
    echo "Unsupported architecture $target_triple"
    exit 1
fi

# Generate the licenses first, so they can be baked into the binaries
script/generate-licenses

rustup target add $target_triple

echo "Compiling zed binaries"
cargo build ${build_flag} --package zed --package cli --features zed/debug-embed --target $target_triple
# Build remote_server in separate invocation to prevent feature unification from other crates
# from influencing dynamic libraries required by it.
# Private debug bundles run this binary outside the source tree, so force
# rust-embed to carry settings/keymap assets just as a release build does.
cargo build ${build_flag} --package remote_server --features debug-embed --target $target_triple

echo "Creating application bundle"
pushd crates/zed
if [[ -e Cargo.toml.backup ]]; then
    echo "Refusing to overwrite crates/zed/Cargo.toml.backup"
    exit 1
fi

restore_bundle_manifest() {
    if [[ -e Cargo.toml.backup ]]; then
        mv Cargo.toml.backup Cargo.toml
    fi
}
trap restore_bundle_manifest EXIT

sed \
    -i.backup \
    "s/package.metadata.bundle-${channel}/package.metadata.bundle/" \
    Cargo.toml

app_path=$(TERM=xterm-256color cargo bundle ${build_flag} --features zed/debug-embed --target $target_triple --select-workspace-root | xargs)

restore_bundle_manifest
trap - EXIT
popd
echo "Bundled ${app_path}"

# DocumentTypes.plist references CFBundleTypeIconFile "Document", so the bundle must contain Document.icns.
# We use the app icon as a placeholder document icon for now.
document_icon_source="crates/zed/resources/Document.icns"
document_icon_target="${app_path}/Contents/Resources/Document.icns"
if [[ -f "${document_icon_source}" ]]; then
    mkdir -p "$(dirname "${document_icon_target}")"
    cp "${document_icon_source}" "${document_icon_target}"
else
    echo "cargo::warning=Missing ${document_icon_source}; macOS document icons may not appear in Finder."
fi

if [[ $can_code_sign == true ]]; then
    echo "Setting up keychain for code signing..."
    signing_directory=$(mktemp -d)
    signing_keychain="${signing_directory}/zed-signing.keychain-db"
    certificate_file="${signing_directory}/certificate.p12"
    notarization_key_file="${signing_directory}/notarization-key.p8"
    function cleanup() {
        echo "Cleaning up keychain"
        [[ -z "$certificate_file" ]] || rm -f "$certificate_file"
        [[ -z "$notarization_key_file" ]] || rm -f "$notarization_key_file"
        [[ -z "$signing_keychain" ]] || security delete-keychain "$signing_keychain" >/dev/null 2>&1 || true
        [[ -z "${signing_directory:-}" ]] || rmdir "$signing_directory" >/dev/null 2>&1 || true
    }
    trap cleanup EXIT

    keychain_password=$(/usr/bin/uuidgen)
    /usr/bin/install -m 0600 /dev/null "$certificate_file"
    printf '%s' "$certificate_base64" | base64 --decode > "$certificate_file"
    security create-keychain -p "$keychain_password" "$signing_keychain"
    security unlock-keychain -p "$keychain_password" "$signing_keychain"
    security set-keychain-settings -lut 21600 "$signing_keychain"
    security import "$certificate_file" -k "$signing_keychain" -P "$certificate_password" -T /usr/bin/codesign
    security set-key-partition-list -S apple-tool:,apple:,codesign: -s -k "$keychain_password" "$signing_keychain"

fi

GIT_VERSION="v2.43.3"
GIT_VERSION_SHA="fa29823"
GIT_ARM64_SHA256="f014b290f36d121bbc47b29b556044c4f6a2f6494cf78ed2eacfa501b77363b6"
GIT_X86_64_SHA256="02fb29a47a07e9a7f841888661f32ebc80a56930864dd19b674d80ffc429c96d"

function download_and_unpack() {
    local url=$1
    local path_to_unpack=$2
    local target_path=$3
    local expected_sha256=$4
    local temp_dir archive_path actual_sha256

    temp_dir=$(mktemp -d)
    archive_path="${temp_dir}/archive.tar.gz"

    if ! command -v curl &> /dev/null; then
        echo "curl is not installed. Please install curl to continue."
        exit 1
    fi

    curl --silent --show-error --fail --location --output "$archive_path" "$url"
    actual_sha256=$(/usr/bin/shasum -a 256 "$archive_path" | cut -d' ' -f1)
    if [[ "$actual_sha256" != "$expected_sha256" ]]; then
        echo "Downloaded Git archive checksum mismatch" >&2
        exit 1
    fi
    tar -xvz -C "$temp_dir" -f "$archive_path" "$path_to_unpack"

    mv "$temp_dir/$path_to_unpack" "$target_path"

    rm -rf "$temp_dir"
}

function download_git() {
    local architecture=$1
    local target_binary=$2

    tmp_dir=$(mktemp -d)
    pushd "$tmp_dir"

    case "$architecture" in
        aarch64-apple-darwin)
            download_and_unpack "https://github.com/desktop/dugite-native/releases/download/${GIT_VERSION}/dugite-native-${GIT_VERSION}-${GIT_VERSION_SHA}-macOS-arm64.tar.gz" bin/git ./git "$GIT_ARM64_SHA256"
            ;;
        x86_64-apple-darwin)
            download_and_unpack "https://github.com/desktop/dugite-native/releases/download/${GIT_VERSION}/dugite-native-${GIT_VERSION}-${GIT_VERSION_SHA}-macOS-x64.tar.gz" bin/git ./git "$GIT_X86_64_SHA256"
            ;;
        *)
            echo "Unsupported architecture: $architecture"
            exit 1
            ;;
    esac

    popd

    mv "${tmp_dir}/git" "${target_binary}"
    rm -rf "$tmp_dir"
}

function assemble_zed_10x_canary() {
    if [[ "$channel" == "dev" ]]; then
        local launcher_path="${app_path}/Contents/MacOS/zed-10x-launcher"
        local runtime_path="${app_path}/Contents/MacOS/zed-10x-runtime"
        local collector_path="${app_path}/Contents/Resources/zed-10x-canary.mjs"
        local revision_path="${app_path}/Contents/Resources/zed-10x-git-commit"

        mv "${app_path}/Contents/MacOS/zed-10x" "${runtime_path}"
        install -m 0755 script/zed-10x-canary-launcher "${launcher_path}"
        install -m 0755 script/zed-10x-canary.mjs "${collector_path}"
        git rev-parse HEAD > "${revision_path}"
        chmod 0644 "${revision_path}"
        /usr/libexec/PlistBuddy \
            -c "Set :CFBundleExecutable zed-10x-launcher" \
            -c "Add :ZedCliLaunchExecutableDirectly bool true" \
            "${app_path}/Contents/Info.plist"
    fi
}

# Locally-built bundles cannot use published release assets: dev versions embed the
# commit sha, so no release tag can ever match. Bundle commit-matched remote servers
# instead; the client prefers them before consulting the GitHub Releases API.
# Must run after sign_binary so the bundled macOS server carries the signed bytes.
function bundle_zed_10x_remote_servers() {
    local remote_server_dir="${app_path}/Contents/Resources/remote-server"
    local linux_arch linux_triple

    if ! command -v zig > /dev/null || ! command -v cargo-zigbuild > /dev/null; then
        echo "zig and cargo-zigbuild are required to bundle the Linux remote servers for local Zed 10x installs." >&2
        echo "Install them with: brew install zig && cargo install --locked cargo-zigbuild" >&2
        exit 1
    fi

    mkdir -p "${remote_server_dir}"
    gzip -f --stdout --best "target/${target_triple}/${target_dir}/remote_server" \
        > "${remote_server_dir}/zed-remote-server-macos-${arch_suffix}.gz"

    for linux_arch in x86_64 aarch64; do
        linux_triple="${linux_arch}-unknown-linux-musl"
        rustup target add "${linux_triple}"
        # Strip debuginfo like the release workflow does; unstripped servers are ~150MB
        # gzipped and get re-uploaded over SSH on every rebuild.
        RUSTFLAGS="${RUSTFLAGS:-} -C target-feature=+crt-static -C strip=debuginfo" cargo zigbuild ${build_flag} \
            --package remote_server --features debug-embed --target "${linux_triple}"
        gzip -f --stdout --best "target/${linux_triple}/${target_dir}/remote_server" \
            > "${remote_server_dir}/zed-remote-server-linux-${linux_arch}.gz"
    done
}

function codesign_runtime() {
    /usr/bin/codesign \
        --force \
        --timestamp \
        --options runtime \
        --keychain "$signing_keychain" \
        --sign "$IDENTITY" \
        "$@"
}

function codesign_distribution_file() {
    /usr/bin/codesign \
        --force \
        --timestamp \
        --keychain "$signing_keychain" \
        --sign "$IDENTITY" \
        "$@"
}

function sign_app_binaries() {
    local signing_stage_directory=""
    if [[ "$local_install" == true ]]; then
        # A repository may live under a file-provider root. Those daemons can
        # immediately restore FinderInfo after xattr removes it, racing
        # codesign. Sign a metadata-free copy in a local temporary directory so
        # the candidate installed in /Applications is the one we actually
        # verified.
        local assembled_app_path="$app_path"
        signing_stage_directory=$(mktemp -d "${TMPDIR:-/tmp}/zed-10x-signing.XXXXXX")
        local staged_app_path="${signing_stage_directory}/$(basename "$assembled_app_path")"
        /usr/bin/ditto --norsrc --noextattr --noacl "$assembled_app_path" "$staged_app_path"
        app_path="$staged_app_path"
    fi

    local zed_executable_path="${app_path}/Contents/MacOS/zed-10x"
    local entitlements_path="crates/zed/resources/zed.entitlements"
    if [[ "$channel" == "dev" ]]; then
        zed_executable_path="${app_path}/Contents/MacOS/zed-10x-runtime"
    fi
    if [[ "$zed_10x_release" == true ]]; then
        rm -f "${app_path}/Contents/embedded.provisionprofile"
    fi

    rm -rf "${app_path}/Contents/Frameworks"
    mkdir -p "${app_path}/Contents/Frameworks"

    echo "Downloading git binary"
    download_git "${target_triple}" "${app_path}/Contents/MacOS/git"

    if [[ "$zed_10x_release" == false ]]; then
        cp "crates/zed/contents/${channel}/embedded.provisionprofile" "${app_path}/Contents/"
    fi

    # File-provider daemons (iCloud/Drive) can stamp com.apple.FinderInfo onto a
    # freshly-assembled bundle, which codesign rejects as "detritus". The bundle
    # never carries meaningful xattrs at this point, so clear them.
    xattr -cr "${app_path}" 2> /dev/null || true

    if [[ $can_code_sign = true ]]; then
        echo "Code signing binaries"
        codesign_runtime -v "${app_path}/Contents/MacOS/cli"
        codesign_runtime -v "${app_path}/Contents/MacOS/git"
        codesign_runtime --entitlements "$entitlements_path" -v "${zed_executable_path}"
        codesign_runtime --entitlements "$entitlements_path" -v "${app_path}"
    elif [[ "$zed_10x_release" == true ]]; then
        echo "Leaving prepared Zed 10x release inputs unsigned for the isolated signer"
    else
        echo "One or more of the following variables are missing: MACOS_CERTIFICATE, MACOS_CERTIFICATE_PASSWORD, APPLE_NOTARIZATION_KEY, APPLE_NOTARIZATION_KEY_ID, APPLE_NOTARIZATION_ISSUER_ID"

        echo "====== WARNING ======"
        echo "This bundle is being signed without all entitlements, some features (e.g. universal links) will not work"
        echo "====== WARNING ======"

        # NOTE: if you need to test universal links you have a few paths forward:
        # - create a PR and tag it with the `run-bundling` label, and download the .dmg file from there.
        # - get a signing key for the MQ55VZLNZQ team from Nathan.
        # - create your own signing key, and update references to MQ55VZLNZQ to your own team ID
        # then comment out this line.
        local unsigned_entitlements_path="${app_path}/Contents/Resources/zed.entitlements"
        sed '/com.apple.developer.associated-domains/,+1d' \
            crates/zed/resources/zed.entitlements > "$unsigned_entitlements_path"
        # The entitlements write is the final bundle mutation before ad-hoc signing.
        # Clear file-provider metadata again here so it cannot invalidate codesign.
        /usr/bin/xattr -cr "${app_path}"
        codesign --force --deep --entitlements "$unsigned_entitlements_path" --sign ${MACOS_SIGNING_KEY:- -} "${app_path}" -v
    fi

    bundle_name=$(basename "$app_path")

    if [ "$local_install" = true ]; then
        local installed_app_path="/Applications/$bundle_name"
        rm -rf "$installed_app_path"
        mv "$app_path" "$installed_app_path"
        rmdir "$signing_stage_directory"
        # File-provider metadata may be stamped during the move into /Applications,
        # after the pre-signing cleanup above. Clear it again and prove the installed
        # bundle still satisfies the signature contract before reporting success.
        /usr/bin/xattr -cr "$installed_app_path"
        codesign --verify --deep --strict "$installed_app_path"
        if [[ "$channel" == "dev" ]]; then
            script/zed-10x-register-installed-app "$installed_app_path"
        fi
        echo "Installed application bundle: $installed_app_path"
        if [ "$open_result" = true ]; then
            echo "Opening $installed_app_path"
            open "$installed_app_path"
        fi
        return
    elif [ "$open_result" = true ]; then
        open "$app_path"
    fi

    if [[ "$target_dir" = "debug" ]]; then
        echo "Debug build detected - skipping DMG creation and signing"
        if [ "$local_install" = false ]; then
            echo "Created application bundle:"
            echo "$app_path"
        fi
    else
        dmg_target_directory="target/${target_triple}/${target_dir}"
        dmg_source_directory="${dmg_target_directory}/dmg"
        if [[ "$zed_10x_release" == true ]]; then
            dmg_file_path="${dmg_target_directory}/Zed-10x-${arch_suffix}.dmg"
        else
            dmg_file_path="${dmg_target_directory}/Zed-${arch_suffix}.dmg"
        fi
        xcode_bin_dir_path="$(xcode-select -p)/usr/bin"

        rm -rf ${dmg_source_directory}
        mkdir -p ${dmg_source_directory}
        mv "${app_path}" "${dmg_source_directory}"
        if [[ "$zed_10x_release" == true ]]; then
            echo "Prepared unsigned Zed 10x release inputs in ${dmg_source_directory}"
            return
        fi
        echo "Adding symlink to /Applications to ${dmg_source_directory}"
        ln -s /Applications ${dmg_source_directory}

        if [[ "$zed_10x_release" == true ]]; then
            dmg_volume_name="Zed 10x"
        else
            dmg_volume_name="Zed"
        fi
        echo "Creating final DMG at ${dmg_file_path} using ${dmg_source_directory}"
        hdiutil create -volname "$dmg_volume_name" -srcfolder "${dmg_source_directory}" -ov -format UDZO "${dmg_file_path}"

        # If someone runs this bundle script locally, a symlink will be placed in `dmg_source_directory`.
        # This symlink causes CPU issues with Zed if the Zed codebase is the project being worked on, so we simply remove it for now.
        echo "Removing symlink to /Applications from ${dmg_source_directory}"
        rm ${dmg_source_directory}/Applications

        if [[ "$zed_10x_release" == false ]]; then
            echo "Adding license agreement to DMG"
            npm install --global dmg-license minimist
            dmg-license script/terms/terms.json "${dmg_file_path}"
        fi

        if [[ $can_code_sign = true ]]; then
            echo "Notarizing DMG with Apple"
            codesign_distribution_file -v "$(pwd)/${dmg_file_path}"
            /usr/bin/install -m 0600 /dev/null "$notarization_key_file"
            printf '%s\n' "$notarization_key" > "$notarization_key_file"
            "${xcode_bin_dir_path}/notarytool" submit \
                --wait \
                --timeout "$notarization_timeout" \
                --key "$notarization_key_file" \
                --key-id "$notarization_key_id" \
                --issuer "$notarization_issuer_id" \
                "${dmg_file_path}"
            rm -f "$notarization_key_file"
            "${xcode_bin_dir_path}/stapler" staple "${dmg_file_path}"
        fi

        if [ "$open_result" = true ]; then
            open $dmg_target_directory
        fi
    fi
}

function sign_binary() {
    local binary_path=$1

    if [[ $can_code_sign = true ]]; then
        echo "Code signing executable $binary_path"
        codesign_runtime --entitlements crates/zed/resources/zed.entitlements -v "${binary_path}"
    fi
}

function upload_debug_symbols() {
    if [ "$local_install" = true ]; then
        echo "local install; skipping sentry upload."
    elif [[ -n "${SENTRY_AUTH_TOKEN:-}" ]]; then
        echo "Uploading zed debug symbols to sentry..."
        exe_path="target/${target_triple}/release/Zed"
        if ! dsymutil --flat "target/${target_triple}/${target_dir}/zed-10x" 2> target/dsymutil.log; then
            echo "dsymutil failed"
            cat target/dsymutil.log
            exit 1
        fi
        if ! dsymutil --flat "target/${target_triple}/${target_dir}/remote_server" 2> target/dsymutil.log; then
            echo "dsymutil failed"
            cat target/dsymutil.log
            exit 1
        fi
        # note: this uploads the unstripped binary which is needed because it contains
        # .eh_frame data for stack unwinding. see https://github.com/getsentry/symbolic/issues/783
        # Try uploading up to 3 times
        for attempt in 1 2 3; do
            echo "Sentry upload attempt $attempt..."
            if sentry-cli debug-files upload --include-sources --wait -p zed -o zed-dev \
                "target/${target_triple}/${target_dir}/zed-10x.dwarf" \
                "target/${target_triple}/${target_dir}/remote_server.dwarf"; then
                break
            else
                echo "Sentry upload failed on attempt $attempt"
                if [ $attempt -eq 3 ]; then
                    echo "All sentry upload attempts failed"
                    exit 1
                fi
            fi
        done
    else
        echo "missing SENTRY_AUTH_TOKEN. skipping sentry upload."
    fi
}

upload_debug_symbols

cp target/${target_triple}/${target_dir}/zed-10x "${app_path}/Contents/MacOS/zed-10x"
cp target/${target_triple}/${target_dir}/cli "${app_path}/Contents/MacOS/cli"
assemble_zed_10x_canary

sign_binary "target/${target_triple}/${target_dir}/remote_server"
gzip -f --stdout --best "target/${target_triple}/${target_dir}/remote_server" > "target/zed-remote-server-macos-${arch_suffix}.gz"
# Only the local install lane (-i) bundles remote servers: CI bundle jobs run this
# script on runners without zig/cargo-zigbuild, and the release lane publishes its
# servers as release assets instead.
rm -rf "${app_path}/Contents/Resources/remote-server"
if [[ "$channel" == "dev" && "$local_install" == true ]]; then
    bundle_zed_10x_remote_servers
fi
sign_app_binaries
